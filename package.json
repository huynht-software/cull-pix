{
  "name": "cull-pix",
  "version": "1.1.0",
  "author": "huynht-software",
  "repository": { "type": "git", "url": "https://github.com/huynht-software/cull-pix.git" },
  "private": true,
  "description": "A fast local photo culling app for macOS and Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:mac": "node scripts/package.js darwin",
    "package:win": "node scripts/package.js win32",
    "release:win": "electron-builder --config electron-builder.cjs --win --x64 --publish never",
    "release:mac": "electron-builder --config electron-builder.cjs --mac --publish never",
    "test:renderer": "electron scripts/verify-renderer.cjs",
    "test:file-opening": "electron scripts/verify-file-opening.cjs",
    "test:mac-opening": "node scripts/verify-mac-opening.cjs",
    "test:zoom": "electron scripts/verify-zoom.cjs",
    "test:thumbnails": "electron scripts/verify-thumbnails.cjs",
    "test:crops": "electron scripts/verify-crops.cjs",
    "test:panels": "electron scripts/verify-panels.cjs",
    "test:export": "electron scripts/verify-export.cjs",
    "test:crop-performance": "electron scripts/verify-crop-performance.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "44.5.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "exifr": "^7.1.3",
    "sharp": "^0.35.5"
  }
}
